# Copy to .env. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Without a key the coach uses a deterministic explanation.
OPENAI_COACH_MODEL=gpt-4.1-mini
COACH_TIMEOUT_SECONDS=8
ADMIN_API_TOKEN=
# Local launcher uses SQLite; the optional MySQL backend is documented in README.
RULES_BACKEND=sqlite
RECOGNITION_PORT=5001
GUIDANCE_PORT=5002
DASHBOARD_PORT=5003
WEB_PORT=8501
RECOGNITION_TIMEOUT_SECONDS=30
GUIDANCE_TIMEOUT_SECONDS=15
