{
  "$defs": {
    "GuidanceResult": {
      "additionalProperties": false,
      "properties": {
        "submission_id": {
          "title": "Submission Id",
          "type": "string"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "matched",
            "missing_rule",
            "special"
          ],
          "title": "Status",
          "type": "string"
        },
        "category": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "bin_label": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Bin Label",
          "type": "string"
        },
        "preparation_steps": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Preparation Steps",
          "type": "array"
        },
        "explanation": {
          "maxLength": 2000,
          "title": "Explanation",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "rule_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Version"
        },
        "is_fallback": {
          "default": false,
          "title": "Is Fallback",
          "type": "boolean"
        }
      },
      "required": [
        "submission_id",
        "region_id",
        "status",
        "category",
        "bin_label",
        "preparation_steps",
        "explanation"
      ],
      "title": "GuidanceResult",
      "type": "object"
    },
    "RecognitionResult": {
      "additionalProperties": false,
      "properties": {
        "submission_id": {
          "title": "Submission Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "recognized",
            "uncertain",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "item_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Item Key",
          "type": "string"
        },
        "item_name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "material": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Material",
          "type": "string"
        },
        "condition": {
          "enum": [
            "clean",
            "soiled",
            "unknown"
          ],
          "title": "Condition",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "special": {
          "default": false,
          "title": "Special",
          "type": "boolean"
        }
      },
      "required": [
        "submission_id",
        "status",
        "item_key",
        "item_name",
        "material",
        "condition",
        "confidence"
      ],
      "title": "RecognitionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One sorting request; identity and timestamps are initialized by Pydantic.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "region_id": {
      "title": "Region Id",
      "type": "string"
    },
    "status": {
      "default": "processing",
      "enum": [
        "processing",
        "completed",
        "uncertain",
        "unsupported",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    },
    "recognition": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecognitionResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "guidance": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuidanceResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "region_id"
  ],
  "title": "Submission",
  "type": "object"
}
